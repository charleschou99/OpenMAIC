# Pack Builder Environment Configuration
# Copy to .env.local and fill in your values

# DeepSeek API Configuration
# Get your API key at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Optional: Model selection (default: deepseek-chat)
# Options: deepseek-chat, deepseek-coder
DEEPSEEK_MODEL=deepseek-chat

# Cost Estimates (as of 2024):
# - deepseek-chat: ~$0.003 per lesson (~¥0.02)
# - Typical unit (8 lessons): ~$0.024 (~¥0.17)
# - Full semester (40 lessons): ~$0.12 (~¥0.86)
